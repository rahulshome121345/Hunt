# ==========================================
# Startup Hunt - Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Required for AI Analysis & Blueprint Studio)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Turso Cloud Database (Optional - defaults to local SQLite if empty)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 3. Reddit API Credentials (Optional - pipeline includes no-api fallback scraper)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StartupHuntBot/1.0

